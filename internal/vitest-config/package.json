{
  "name": "@jg-packages/vitest-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Vitest configuration factory for the jg-packages workspace.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./test-suite": "./src/test-suite.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@jg-packages/eslint-config": "workspace:*",
    "@jg-packages/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
