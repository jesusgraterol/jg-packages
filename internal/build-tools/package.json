{
  "name": "@jg-packages/build-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Build scripts shared by the jg-packages libraries: clean-dist and copy-assets.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "pnpm test:integration",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@jg-packages/eslint-config": "workspace:*",
    "@jg-packages/tsconfig": "workspace:*",
    "@jg-packages/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
