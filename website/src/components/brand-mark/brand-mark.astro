---
interface Props {
  // sizing and layout classes for the mark
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

{/* the JG/ monogram the jg sites share, a dark tile in both themes */}
<svg
  class={className}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
>
  <rect
    x="2"
    y="2"
    width="60"
    height="60"
    rx="12"
    class="fill-terminal stroke-border-strong"
    stroke-width="1"
  ></rect>
  <text
    x="32"
    y="42"
    text-anchor="middle"
    font-family="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, monospace"
    font-size="28"
    font-weight="800"
    letter-spacing="-2"
  >
    <tspan class="fill-terminal-foreground">JG</tspan>
    <tspan class="fill-terminal-accent">/</tspan>
  </text>
</svg>
