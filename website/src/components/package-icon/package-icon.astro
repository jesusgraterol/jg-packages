---
import {
  Atom,
  Braces,
  Calculator,
  Clipboard,
  CloudOff,
  Cpu,
  Database,
  FolderOpen,
  Globe,
  KeyRound,
  LockKeyhole,
  OctagonAlert,
  RefreshCw,
  Route,
  Server,
  Table2,
  Wrench,
  Zap,
} from '@lucide/astro';
import IconTile from 'jg-personal-astro-ui/icon-tile';

import type { IPackageIcon } from '../../utilities/package-catalog/index.ts';

interface Props {
  icon: IPackageIcon;
  // `card` leads a package card's top row; `header` opens a package page
  size: 'card' | 'header';
}

// the Lucide component behind each icon key
const LUCIDE_ICONS = {
  atom: Atom,
  braces: Braces,
  calculator: Calculator,
  clipboard: Clipboard,
  'cloud-off': CloudOff,
  cpu: Cpu,
  database: Database,
  'folder-open': FolderOpen,
  globe: Globe,
  'key-round': KeyRound,
  'lock-keyhole': LockKeyhole,
  'octagon-alert': OctagonAlert,
  'refresh-cw': RefreshCw,
  route: Route,
  server: Server,
  'table-2': Table2,
  wrench: Wrench,
  zap: Zap,
} as const satisfies Record<IPackageIcon, typeof Braces>;

// the glyph's drawn size in pixels; the tile sizes it with CSS too
const GLYPH_PIXELS = { card: 20, header: 28 } as const;

const { icon, size } = Astro.props;
const Glyph = LUCIDE_ICONS[icon];
---

{/* decorative: the package's name is always shown with the tile */}
<IconTile
  size={size}
  data-package-icon={icon}
>
  <Glyph size={GLYPH_PIXELS[size]} />
</IconTile>
