---
// one link of the table of contents, with the links nested under it
interface IContentsItem {
  children?: readonly IContentsItem[] | undefined;
  href: string;
  label: string;
}

interface Props {
  items: readonly IContentsItem[];
  // 'sidebar' for the sticky column on wide screens, 'disclosure' for the collapsible list above
  // the content on narrow ones
  variant: 'sidebar' | 'disclosure';
}

const { items, variant } = Astro.props;
---

{variant === 'sidebar' ? (
  <nav
    aria-label="On this page"
    class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2 pb-8"
    data-pagefind-ignore
  >
    <p class="eyebrow">On this page</p>
    <ul class="mt-4 grid gap-1 border-l border-border text-sm">
      {items.map(({ children = [], href, label }) => (
        <li>
          <a
            href={href}
            class="-ml-px block border-l border-transparent py-1 pl-4 text-muted no-underline transition-colors hover:border-foreground hover:text-foreground"
          >
            {label}
          </a>
          {children.length > 0 && (
            <ul class="grid gap-0.5">
              {children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    class="-ml-px block border-l border-transparent py-1 pl-7 text-[0.8125rem] text-muted no-underline transition-colors hover:border-foreground hover:text-foreground"
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
) : (
  <details
    class="group rounded-xl border border-border bg-surface"
    data-pagefind-ignore
  >
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold marker:content-none [&::-webkit-details-marker]:hidden">
      On this page
      <span
        class="font-mono text-xs text-muted group-open:hidden"
        aria-hidden="true"
      >
        +
      </span>
      <span
        class="hidden font-mono text-xs text-muted group-open:inline"
        aria-hidden="true"
      >
        −
      </span>
    </summary>
    <nav
      aria-label="On this page"
      class="border-t border-border px-4 py-3"
    >
      <ul class="grid gap-1 text-sm">
        {items.map(({ children = [], href, label }) => (
          <li>
            <a
              href={href}
              class="block py-1 no-underline hover:underline"
            >
              {label}
            </a>
            {children.length > 0 && (
              <ul class="grid gap-0.5 pl-4">
                {children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="block py-1 text-muted no-underline hover:text-foreground hover:underline"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}
