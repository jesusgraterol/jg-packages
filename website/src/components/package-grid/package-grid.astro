---
import { ArrowDown } from '@lucide/astro';

import type { IListedPackage } from '../../utilities/package-catalog/index.ts';
import PackageIcon from '../package-icon/package-icon.astro';

interface Props {
  class?: string | undefined;
  packages: readonly IListedPackage[];
}

// the most tiles the hero shows, so it keeps its shape as packages are added; a link under them
// reaches the rest
const HERO_PACKAGE_LIMIT = 8;

const { class: className, packages } = Astro.props;
const shownPackages = packages.slice(0, HERO_PACKAGE_LIMIT);
---

{/* the set at a glance: the first packages as icon tiles that open their pages, then a link to all */}
<div class={className}>
  <ul
    class="grid grid-cols-2 gap-2 sm:gap-3"
    aria-label="The packages"
  >
    {shownPackages.map((listedPackage) => (
      <li>
        <a
          href={`/packages/${listedPackage.name}/`}
          class="group flex h-full min-w-0 flex-col items-start gap-2.5 rounded-xl border border-border bg-surface p-3 shadow-surface transition-colors hover:border-border-strong sm:flex-row sm:items-center sm:gap-3"
        >
          <PackageIcon
            icon={listedPackage.icon}
            size="card"
          />
          <span class="min-w-0">
            <span class="block font-mono text-sm font-semibold wrap-anywhere group-hover:underline">
              {listedPackage.name}
            </span>
            <span class="block text-xs text-muted">{listedPackage.title}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  {shownPackages.length < packages.length && (
    <a
      href="#packages"
      class="mt-2 inline-flex min-h-9 items-center gap-1.5 text-sm font-semibold underline-offset-4 hover:underline"
    >
      View all {packages.length} packages
      <ArrowDown
        class="size-4"
        aria-hidden="true"
      />
    </a>
  )}
</div>
