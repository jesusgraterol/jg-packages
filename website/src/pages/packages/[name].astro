---
import { groupSymbols } from '@jg-packages/api-reference';
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import DocumentationOutline from 'jg-personal-astro-ui/documentation-outline';
import DocumentationShell from 'jg-personal-astro-ui/documentation-shell';
import PageNavigation from 'jg-personal-astro-ui/page-navigation';
import Prose from 'jg-personal-astro-ui/prose';
import { buildStructuredData } from 'jg-site';

import ApiReference from '../../components/api-reference/api-reference.astro';
import PackageHero from '../../components/package-hero/package-hero.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { PACKAGE_CATALOG, PACKAGES_DIRECTORY, SITE_CONFIG } from '../../site.config.ts';
import { toMarkdownPath } from '../../utilities/markdown-pages/index.ts';
import { loadListedPackages, type IListedPackage } from '../../utilities/package-catalog/index.ts';
import { loadApiReference } from '../../utilities/site-markdown/index.ts';

interface Props {
  package: IListedPackage;
}

export const getStaticPaths = (async () =>
  (await loadListedPackages(PACKAGE_CATALOG, PACKAGES_DIRECTORY)).map((listedPackage) => ({
    params: { name: listedPackage.name },
    props: { package: listedPackage },
  }))) satisfies GetStaticPaths;

const { package: listedPackage } = Astro.props;
const reference = loadApiReference(listedPackage.name);
const readme = await getEntry('packageReadmes', listedPackage.name);
if (readme === undefined) {
  throw new Error(`${listedPackage.name} has no README entry`);
}
const { Content, headings } = await render(readme);
const pagePath = `/packages/${listedPackage.name}/`;
const title = `${listedPackage.name}: ${listedPackage.title} | ${SITE_CONFIG.name}`;
const structuredData = buildStructuredData({
  breadcrumbs: [
    { name: SITE_CONFIG.name, path: '/' },
    { name: listedPackage.name, path: pagePath },
  ],
  canonicalUrl: new URL(pagePath, SITE_CONFIG.url).toString(),
  description: listedPackage.description,
  site: SITE_CONFIG,
  sourceCode: {
    codeRepository: `${SITE_CONFIG.repositoryUrl}/tree/main/packages/${listedPackage.name}`,
    license: `${SITE_CONFIG.repositoryUrl}/blob/main/packages/${listedPackage.name}/LICENSE`,
    name: listedPackage.name,
    programmingLanguage: 'TypeScript',
    version: listedPackage.version,
  },
  title,
  type: 'webpage',
});
const contents = [
  ...headings
    .filter(({ depth }) => depth === 2)
    .map(({ slug, text }) => ({ href: `#${slug}`, label: text })),
  {
    href: '#api-reference',
    label: 'API reference',
    children: reference.entryPoints.flatMap((entryPoint) =>
      groupSymbols(entryPoint).map(({ heading, id }) => ({
        href: `#${id}`,
        label:
          reference.entryPoints.length > 1 && entryPoint.subpath !== '.'
            ? `${heading} (${entryPoint.subpath.replace(/^\.\//, '')})`
            : heading,
      })),
    ),
  },
];
---

<BaseLayout
  canonicalPath={pagePath}
  description={listedPackage.description}
  markdownPath={toMarkdownPath(pagePath)}
  structuredData={structuredData}
  title={title}
>
  <PackageHero package={listedPackage} />
  <DocumentationShell>
    <DocumentationOutline
      slot="outline"
      items={contents}
    />
    <div class="min-w-0 lg:max-w-[48rem]">
      <Prose>
        <Content />
      </Prose>
      <ApiReference reference={reference} />
    </div>
    <PageNavigation
      slot="footer"
      class="lg:max-w-[48rem]"
      next={{ href: `${pagePath}recipes/`, label: `${listedPackage.name} recipes` }}
    />
  </DocumentationShell>
</BaseLayout>
