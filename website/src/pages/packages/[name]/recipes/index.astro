---
import { ArrowLeft } from '@lucide/astro';
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import Breadcrumb from 'jg-personal-astro-ui/breadcrumb';
import Button from 'jg-personal-astro-ui/button';
import CopyButton from 'jg-personal-astro-ui/copy-button';
import DocumentationOutline from 'jg-personal-astro-ui/documentation-outline';
import DocumentationShell from 'jg-personal-astro-ui/documentation-shell';
import HeroBackdrop from 'jg-personal-astro-ui/hero-backdrop';
import PageNavigation from 'jg-personal-astro-ui/page-navigation';
import Prose from 'jg-personal-astro-ui/prose';
import { buildStructuredData, SEARCH_TEXT_LIMITS } from 'jg-site';

import PackageIcon from '../../../../components/package-icon/package-icon.astro';
import BaseLayout from '../../../../layouts/base-layout.astro';
import { PACKAGE_CATALOG, PACKAGES_DIRECTORY, SITE_CONFIG } from '../../../../site.config.ts';
import { toMarkdownPath } from '../../../../utilities/markdown-pages/index.ts';
import {
  loadListedPackages,
  type IListedPackage,
} from '../../../../utilities/package-catalog/index.ts';

interface Props {
  package: IListedPackage;
}

export const getStaticPaths = (async () =>
  (await loadListedPackages(PACKAGE_CATALOG, PACKAGES_DIRECTORY)).map((listedPackage) => ({
    params: { name: listedPackage.name },
    props: { package: listedPackage },
  }))) satisfies GetStaticPaths;

const { package: listedPackage } = Astro.props;
const packagePath = `/packages/${listedPackage.name}/`;
const recipes = await getEntry('packageRecipes', listedPackage.name);
if (recipes === undefined) {
  throw new Error(`${listedPackage.name} has no recipes entry`);
}
const { Content, headings } = await render(recipes);
// each recipe is a level-two section
const contents = headings
  .filter(({ depth }) => depth === 2)
  .map(({ slug, text }) => ({ href: `#${slug}`, label: text }));
// the sentence under the title says what the recipes show, which describes the page when it fits
// search results; a longer one gives way to the recipes' names
const summary = recipes.body?.split('\n\n')[0]?.trim() ?? '';
const description =
  summary.length >= SEARCH_TEXT_LIMITS.descriptionMinLength &&
  summary.length <= SEARCH_TEXT_LIMITS.descriptionMaxLength
    ? summary
    : `${listedPackage.name} recipes: ${contents
        .map(({ label }) => label.charAt(0).toLowerCase() + label.slice(1))
        .join(', ')}.`;
const pagePath = `${packagePath}recipes/`;
const title = `${listedPackage.name} recipes | ${SITE_CONFIG.name}`;
const structuredData = buildStructuredData({
  breadcrumbs: [
    { name: SITE_CONFIG.name, path: '/' },
    { name: listedPackage.name, path: packagePath },
    { name: 'Recipes', path: pagePath },
  ],
  canonicalUrl: new URL(pagePath, SITE_CONFIG.url).toString(),
  description,
  site: SITE_CONFIG,
  title,
  type: 'webpage',
});
---

<BaseLayout
  canonicalPath={pagePath}
  description={description}
  markdownPath={toMarkdownPath(pagePath)}
  structuredData={structuredData}
  title={title}
>
  <header class="relative isolate overflow-hidden border-b border-border">
    <HeroBackdrop class="opacity-70" />
    <div class="jg-container pt-8 pb-12 sm:pt-10 sm:pb-16">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
        <Breadcrumb
          items={[
            { name: SITE_CONFIG.name, href: '/' },
            { name: listedPackage.name, href: packagePath },
            { name: 'Recipes', href: pagePath },
          ]}
        />
        <CopyButton
          display="icon"
          class="ml-auto"
          context="as Markdown"
          label="Copy page"
          tone="outline"
          url={toMarkdownPath(pagePath)}
        />
      </div>
      <div class="mt-10 flex items-center gap-4 sm:gap-5">
        <PackageIcon
          icon={listedPackage.icon}
          size="header"
        />
        <div class="min-w-0">
          <p class="eyebrow">Recipes</p>
          {/* the package page's title is the name too, so search names this one apart */}
          <h1
            class="jg-page-title mt-2"
            data-jg-title-font="mono"
            data-pagefind-meta={`title:${listedPackage.name} recipes`}
          >
            {listedPackage.name}
          </h1>
        </div>
      </div>
      <Button
        href={packagePath}
        class="mt-8"
        size="sm"
        variant="outline"
      >
        <ArrowLeft
          class="size-4"
          aria-hidden="true"
        />
        Back to {listedPackage.name}
      </Button>
    </div>
  </header>
  <DocumentationShell>
    <DocumentationOutline
      slot="outline"
      items={contents}
    />
    <div class="min-w-0 lg:max-w-[48rem]">
      <Prose>
        <Content />
      </Prose>
    </div>
    <PageNavigation
      slot="footer"
      class="lg:max-w-[48rem]"
      previous={{ href: packagePath, label: listedPackage.name, description: listedPackage.title }}
    />
  </DocumentationShell>
</BaseLayout>
