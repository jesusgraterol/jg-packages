---
import {
  ArrowLeftRight,
  BookOpenText,
  FileCheck,
  Minimize2,
  PackageCheck,
  Ruler,
} from '@lucide/astro';
import Button from 'jg-personal-astro-ui/button';
import HeroBackdrop from 'jg-personal-astro-ui/hero-backdrop';
import Section from 'jg-personal-astro-ui/section';
import TextLink from 'jg-personal-astro-ui/text-link';

import AgentSetup from '../components/agent-setup/agent-setup.astro';
import PackageCard from '../components/package-card/package-card.astro';
import PackageGrid from '../components/package-grid/package-grid.astro';
import BaseLayout from '../layouts/base-layout.astro';
import { PACKAGE_CATALOG, PACKAGES_DIRECTORY, SITE_CONFIG } from '../site.config.ts';
import {
  AGENT_RESOURCES,
  HOME_BENEFITS,
  HOME_HERO,
  HOME_SECTIONS,
} from '../utilities/home-content/index.ts';
import { toMarkdownPath } from '../utilities/markdown-pages/index.ts';
import { groupPackagesByRuntime, loadListedPackages } from '../utilities/package-catalog/index.ts';
import { buildStructuredData } from 'jg-personal-astro-ui/seo';

// the icon of each benefit, by its id
const BENEFIT_ICONS: Record<(typeof HOME_BENEFITS)[number]['id'], typeof Minimize2> = {
  'less-code': Minimize2,
  'one-error-model': ArrowLeftRight,
  'docs-inside': BookOpenText,
  'checked-examples': FileCheck,
  'tested-as-installed': PackageCheck,
  'one-set-of-conventions': Ruler,
};

const packages = await loadListedPackages(PACKAGE_CATALOG, PACKAGES_DIRECTORY);
const groups = groupPackagesByRuntime(packages);
const title = `${SITE_CONFIG.name} | TypeScript packages for coding agents`;
const structuredData = buildStructuredData({
  canonicalUrl: new URL('/', SITE_CONFIG.url).toString(),
  description: SITE_CONFIG.defaultDescription,
  listedPages: packages.map(({ name }) => ({ name, path: `/packages/${name}/` })),
  site: SITE_CONFIG,
  title,
  type: 'website',
});
---

<BaseLayout
  canonicalPath="/"
  description={SITE_CONFIG.defaultDescription}
  markdownPath={toMarkdownPath('/')}
  structuredData={structuredData}
  title={title}
>
  <section class="relative isolate overflow-hidden border-b border-border">
    <HeroBackdrop />
    <div class="jg-container grid items-center gap-12 pt-14 pb-16 sm:pt-20 sm:pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
      <div>
        <p class="eyebrow">{HOME_HERO.eyebrow}</p>
        <h1
          class="display-title mt-6"
          data-pagefind-meta={`title:${SITE_CONFIG.name}`}
        >
          {HOME_HERO.titleStart}
          <span class="block text-accent">{HOME_HERO.titleEnd}</span>
        </h1>
        <p class="lede mt-7">{HOME_HERO.lede}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="#setup">Set up your agent</Button>
          <Button
            href="#packages"
            variant="outline"
          >
            View all packages
          </Button>
        </div>
      </div>
      <PackageGrid packages={packages} />
    </div>
  </section>

  <Section
    id="packages"
    eyebrow={HOME_SECTIONS.packages.eyebrow}
    title={HOME_SECTIONS.packages.title}
    lede={HOME_SECTIONS.packages.lede}
  >
    <div class="mt-12 grid gap-12">
      {groups.map(({ heading, packages: groupPackages, runtime, summary }) => (
        <section aria-labelledby={`runtime-${runtime}`}>
          <div class="flex flex-col gap-1 border-b border-border pb-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <h3
              id={`runtime-${runtime}`}
              class="text-xl font-semibold tracking-tight"
            >
              {heading}
            </h3>
            <p class="text-sm text-muted">{summary}</p>
          </div>
          <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {groupPackages.map((listedPackage) => (
              <li>
                <PackageCard
                  headingLevel={4}
                  package={listedPackage}
                />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </Section>

  <Section
    id="why"
    eyebrow={HOME_SECTIONS.why.eyebrow}
    title={HOME_SECTIONS.why.title}
    lede={HOME_SECTIONS.why.lede}
  >
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {HOME_BENEFITS.map(({ id, text, title: benefitTitle }) => {
        const Icon = BENEFIT_ICONS[id];
        return (
          <li class="rounded-xl border border-border bg-surface p-5 shadow-surface">
            <span
              class="inline-flex size-9 items-center justify-center rounded-lg border border-border bg-background text-accent"
              aria-hidden="true"
            >
              <Icon class="size-[1.125rem]" />
            </span>
            <h3 class="mt-4 text-base font-semibold tracking-tight">{benefitTitle}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{text}</p>
          </li>
        );
      })}
    </ul>
  </Section>

  <Section
    id="setup"
    eyebrow={HOME_SECTIONS.setup.eyebrow}
    title={HOME_SECTIONS.setup.title}
    lede={HOME_SECTIONS.setup.lede}
  >
    <AgentSetup />
  </Section>

  <Section
    id="agents"
    eyebrow={HOME_SECTIONS.agents.eyebrow}
    title={HOME_SECTIONS.agents.title}
    lede={HOME_SECTIONS.agents.lede}
    border={false}
  >
    <ul class="mt-12 grid gap-4 sm:grid-cols-2">
      {AGENT_RESOURCES.map(({ href, path, text }) => (
        <li class="rounded-xl border border-border bg-surface p-5 shadow-surface">
          {href === undefined ? (
            <code class="font-mono text-sm font-bold wrap-anywhere">{path}</code>
          ) : (
            <a
              href={href}
              class="font-mono text-sm font-bold wrap-anywhere underline decoration-current/40 underline-offset-4 hover:decoration-current"
            >
              {path}
            </a>
          )}
          <p class="mt-2 text-sm leading-6 text-muted">{text}</p>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-sm text-muted">
      The source and the release process are on{' '}
      <TextLink
        href={SITE_CONFIG.repositoryUrl}
        external
      >
        GitHub
      </TextLink>
      .
    </p>
  </Section>
</BaseLayout>
