{
  "name": "@jg-packages/website",
  "version": "0.0.0",
  "private": true,
  "description": "The jg-packages website: a showcase and the documentation of every listed package, built for people and agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assets:generate": "node scripts/generate-open-graph.ts",
    "build": "astro build && pagefind --site dist && node scripts/verify-build.ts",
    "dev": "astro dev",
    "generate": "node scripts/generate-api-reference.ts",
    "lint": "astro sync && eslint .",
    "preview": "astro preview",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/sitemap": "3.7.4",
    "@lucide/astro": "1.58.0",
    "@tailwindcss/vite": "catalog:",
    "astro": "catalog:",
    "jg-personal-astro-ui": "workspace:*",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@axe-core/playwright": "4.13.0",
    "@jg-packages/api-reference": "workspace:*",
    "@jg-packages/eslint-config": "workspace:*",
    "@jg-packages/vitest-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jg-api-response": "workspace:*",
    "jg-bignumber": "workspace:*",
    "jg-clipboard": "workspace:*",
    "jg-crypto": "workspace:*",
    "jg-local-docker": "workspace:*",
    "jg-locks": "workspace:*",
    "jg-playwright": "workspace:*",
    "jg-env": "workspace:*",
    "jg-postgres": "workspace:*",
    "jg-tanstack-query": "workspace:*",
    "jg-react": "workspace:*",
    "jg-react-router": "workspace:*",
    "jg-nestjs": "workspace:*",
    "jg-redis": "workspace:*",
    "jg-exception": "workspace:*",
    "jg-fetch": "workspace:*",
    "jg-fs": "workspace:*",
    "jg-git-commands": "workspace:*",
    "jg-github": "workspace:*",
    "jg-process": "workspace:*",
    "jg-site": "workspace:*",
    "jg-storage": "workspace:*",
    "jg-sw": "workspace:*",
    "jg-utilities": "workspace:*",
    "pagefind": "1.5.2",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
