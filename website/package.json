{
  "name": "@jg-packages/website",
  "version": "0.0.0",
  "private": true,
  "description": "The jg-packages website: a showcase and the documentation of every listed package, built for people and agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "generate": "node scripts/generate-api-reference.ts",
