    "test:unit": "vitest run --project unit",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@lucide/astro": "1.58.0",
    "@tailwindcss/vite": "catalog:",
    "astro": "catalog:",
    "jg-personal-astro-ui": "workspace:*",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@jg-packages/api-reference": "workspace:*",
    "@jg-packages/eslint-config": "workspace:*",
    "@jg-packages/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jg-api-response": "workspace:*",
    "jg-bignumber": "workspace:*",
    "jg-exception": "workspace:*",
    "jg-fetch": "workspace:*",
    "jg-fs": "workspace:*",
    "jg-process": "workspace:*",
    "jg-storage": "workspace:*",
    "jg-sw": "workspace:*",
    "jg-utilities": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
