{
  "name": "jg-personal-astro-ui",
  "version": "0.4.0",
  "description": "Jesus Graterol's Astro components, Tailwind token contract, and theme, shared by his personal websites.",
  "author": "Jesus Graterol",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./styles/contract.css": {
      "style": "./src/styles/contract.css",
      "default": "./src/styles/contract.css"
    },
    "./styles/theme.css": {
      "style": "./src/styles/theme.css",
      "default": "./src/styles/theme.css"
    },
    "./styles/prose.css": {
      "style": "./src/styles/prose.css",
      "default": "./src/styles/prose.css"
    },
    "./code-window": "./src/code-window/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./code-window-plugin": "./src/code-window-plugin/index.ts",
    "./external-link-plugin": "./src/external-link-plugin/index.ts",
    "./new-tab-marker-markup": "./src/new-tab-marker-markup/index.ts",
    "./syntax-theme": "./src/syntax-theme/index.ts",
    "./accordion": "./src/components/accordion/accordion.astro",
    "./agentic-coding-mark": "./src/components/agentic-coding-mark/agentic-coding-mark.astro",
    "./agentic-coding-mark.svg": "./src/components/agentic-coding-mark/agentic-coding-mark.svg",
    "./badge": "./src/components/badge/badge.astro",
    "./brand-logo": "./src/components/brand-logo/brand-logo.astro",
    "./breadcrumb": "./src/components/breadcrumb/breadcrumb.astro",
    "./button": "./src/components/button/button.astro",
    "./callout": "./src/components/callout/callout.astro",
    "./card": "./src/components/card/card.astro",
    "./code-block": "./src/components/code-block/code-block.astro",
    "./code-diff": "./src/components/code-diff/code-diff.astro",
    "./container": "./src/components/container/container.astro",
    "./conversation": "./src/components/conversation/conversation.astro",
    "./conversation-message": "./src/components/conversation-message/conversation-message.astro",
    "./copy-button": "./src/components/copy-button/copy-button.astro",
    "./dialog": "./src/components/dialog/dialog.astro",
    "./document-head": "./src/components/document-head/document-head.astro",
    "./documentation-outline": "./src/components/documentation-outline/documentation-outline.astro",
    "./documentation-shell": "./src/components/documentation-shell/documentation-shell.astro",
    "./file-preview": "./src/components/file-preview/file-preview.astro",
    "./file-tree": "./src/components/file-tree/file-tree.astro",
    "./hero-backdrop": "./src/components/hero-backdrop/hero-backdrop.astro",
    "./icon-tile": "./src/components/icon-tile/icon-tile.astro",
    "./inline-code": "./src/components/inline-code/inline-code.astro",
    "./jg-mark": "./src/components/jg-mark/jg-mark.astro",
    "./jg-mark.svg": "./src/components/jg-mark/jg-mark.svg",
    "./jg-favicon.svg": "./src/components/jg-mark/jg-favicon.svg",
    "./install-command": "./src/components/install-command/install-command.astro",
    "./kbd": "./src/components/kbd/kbd.astro",
    "./link-card": "./src/components/link-card/link-card.astro",
    "./navigation-progress": "./src/components/navigation-progress/navigation-progress.astro",
    "./new-tab-marker": "./src/components/new-tab-marker/new-tab-marker.astro",
    "./package-manager-tabs": "./src/components/package-manager-tabs/package-manager-tabs.astro",
    "./page-header": "./src/components/page-header/page-header.astro",
    "./page-navigation": "./src/components/page-navigation/page-navigation.astro",
    "./prose": "./src/components/prose/prose.astro",
    "./search-dialog": "./src/components/search-dialog/search-dialog.astro",
    "./section": "./src/components/section/section.astro",
    "./segmented-control": "./src/components/segmented-control/segmented-control.astro",
    "./site-footer": "./src/components/site-footer/site-footer.astro",
    "./site-header": "./src/components/site-header/site-header.astro",
    "./skip-link": "./src/components/skip-link/skip-link.astro",
    "./stack": "./src/components/stack/stack.astro",
    "./table": "./src/components/table/table.astro",
    "./tabs": "./src/components/tabs/tabs.astro",
    "./terminal-window": "./src/components/terminal-window/terminal-window.astro",
    "./text-link": "./src/components/text-link/text-link.astro",
    "./theme-control": "./src/components/theme-control/theme-control.astro",
    "./theme-init-script": "./src/components/theme-init-script/theme-init-script.astro"
  },
  "files": [
    "src",
    "!src/**/*.test-*",
    "CHANGELOG.md",
    "API.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusgraterol/jg-packages.git",
    "directory": "packages/jg-personal-astro-ui"
  },
  "homepage": "https://github.com/jesusgraterol/jg-packages/tree/main/packages/jg-personal-astro-ui#readme",
  "bugs": {
    "url": "https://github.com/jesusgraterol/jg-packages/issues"
  },
  "keywords": [
    "astro",
    "astro-components",
    "tailwindcss",
    "design-tokens",
    "theme"
  ],
  "scripts": {
    "build": "node ../../internal/api-reference/src/write-api-markdown.ts",
    "gallery:dev": "astro dev --root gallery",
    "gallery:build": "astro build --root gallery && pagefind --site gallery/dist",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:browser && pnpm test:e2e",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "test:e2e": "pnpm gallery:build && playwright test",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "astro check && astro check --root gallery"
  },
  "peerDependencies": {
    "astro": "^7.4.0",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@fontsource-variable/ubuntu-sans": "^5.3.0",
    "@fontsource-variable/ubuntu-sans-mono": "^5.3.0",
    "@lucide/astro": "^1.58.0",
    "diff": "^9.0.0",
    "jg-clipboard": "workspace:^",
    "jg-exception": "workspace:^",
    "jg-site": "workspace:^",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/markdown-satteri": "0.4.4",
    "@axe-core/playwright": "4.13.0",
    "@jg-packages/eslint-config": "workspace:*",
    "@jg-packages/vitest-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "astro": "catalog:",
    "eslint": "catalog:",
    "jg-playwright": "workspace:*",
    "jg-process": "workspace:*",
    "pagefind": "1.5.2",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
