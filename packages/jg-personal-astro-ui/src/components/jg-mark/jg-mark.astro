---
import { JG_MARK_PATHS, JG_MARK_TILE, JG_MARK_VIEW_BOX } from 'jg-personal-ui/brand';

interface Props {
  // sizing and layout classes for the mark, such as size-8
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

{/* canonical geometry and fixed colors are shared with React and standalone assets */}
<svg
  class={className}
  viewBox={JG_MARK_VIEW_BOX}
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect {...JG_MARK_TILE}></rect>
  {JG_MARK_PATHS.map((path) => (
    <path {...path}></path>
  ))}
</svg>
