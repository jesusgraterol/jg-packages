---
import { highlightToLines } from '../../highlighting/index.ts';

import type { ICodeDiffProps } from './types.ts';
import { buildDiffModel, toHighlightSource } from './utilities.ts';
import { renderDiffMarkup } from './rendering.ts';

type Props = ICodeDiffProps;

const {
  after,
  appearance = 'window',
  before,
  class: className,
  contextLines,
  highlightWords = false,
  lang,
  lineNumbers = false,
  overflow = 'scroll',
  view = 'auto',
} = Astro.props;
const model = buildDiffModel(before.code, after.code, { contextLines, highlightWords });
const [beforeTokens, afterTokens] = await Promise.all([
  highlightToLines(toHighlightSource(model.beforeLines), lang),
  highlightToLines(toHighlightSource(model.afterLines), lang),
]);
const markup = renderDiffMarkup(model, beforeTokens, afterTokens, { lineNumbers, overflow });
const splitVisibility =
  view === 'unified' ? 'hidden' : view === 'auto' ? 'hidden @3xl:grid' : 'grid';
const columns =
  view === 'unified' ? undefined : view === 'split' ? 'grid-cols-2' : '@3xl:grid-cols-2';
const label = `Changes from ${before.title} to ${after.title}`;
const numberDigits = Math.max(
  2,
  String(Math.max(model.beforeLines.length, model.afterLines.length)).length,
);
---

{/* one build-time comparison supplies every view; wrapped split rows share their vertical sizing */}
<figure
  class:list={[
    'jg-code-diff @container min-w-0',
    appearance === 'window' && 'overflow-hidden rounded-xl border border-border bg-code',
    className,
  ]}
  data-code-diff
  data-code-diff-overflow={overflow}
  style={{ '--jg-diff-number-width': `${numberDigits}ch` }}
>
  <figcaption
    class:list={[
      'grid font-mono text-xs',
      appearance === 'window' && 'border-b border-border',
      columns,
    ]}
  >
    <span class="flex min-h-10 min-w-0 items-center gap-2 px-4 text-muted wrap-anywhere">
      <span
        class="size-2 shrink-0 rounded-full bg-danger"
        aria-hidden="true"
      ></span>
      {before.title}
    </span>
    <span
      class:list={[
        'flex min-h-10 min-w-0 items-center gap-2 px-4 text-muted wrap-anywhere',
        appearance === 'window' &&
          (view === 'split'
            ? 'border-l border-border'
            : view === 'auto'
              ? 'border-t border-border @3xl:border-t-0 @3xl:border-l'
              : 'border-t border-border'),
      ]}
    >
      <span
        class="size-2 shrink-0 rounded-full bg-success"
        aria-hidden="true"
      ></span>
      {after.title}
    </span>
  </figcaption>
  {model.isFallback && (
    <p
      class="px-4 py-2 text-xs text-muted"
      data-diff-fallback
    >
      Comparison exceeded the edit limit. Showing the complete before and after source as a
      replacement.
    </p>
  )}
  {markup.rows.length === 0 && <p class="px-4 py-3 text-sm text-muted">No changes.</p>}
  <pre
    class:list={[
      'jg-code jg-diff-pre',
      view === 'split' ? 'hidden' : view === 'auto' ? '@3xl:hidden' : undefined,
    ]}
    tabindex="0"
    role="group"
    aria-label={label}
    data-diff-unified
  ><code set:html={markup.unified} /></pre>
  {overflow === 'scroll' ? (
    <div
      class:list={[splitVisibility, 'grid-cols-2']}
      data-diff-split
    >
      <pre
        class="jg-code jg-diff-pre min-w-0"
        tabindex="0"
        role="group"
        aria-label={before.title}
      ><code set:html={markup.rows.map(row => row.before).join('')} /></pre>
      <pre
        class:list={[
          'jg-code jg-diff-pre min-w-0',
          appearance === 'window' && 'border-l border-border',
        ]}
        tabindex="0"
        role="group"
        aria-label={after.title}
      ><code set:html={markup.rows.map(row => row.after).join('')} /></pre>
    </div>
  ) : (
    <div
      class:list={[splitVisibility, 'jg-diff-wrapped grid-cols-2 font-mono']}
      tabindex="0"
      role="group"
      aria-label={label + ' side by side'}
      data-diff-split
    >
      {markup.rows.map((row) =>
        row.isOmitted ? (
          <div
            class="col-span-2"
            set:html={row.before}
          />
        ) : (
          <>
            <div class="min-w-0">
              <span class="sr-only">{before.title}: </span>
              <code set:html={row.before} />
            </div>
            <div class:list={['min-w-0', appearance === 'window' && 'border-l border-border']}>
              <span class="sr-only">{after.title}: </span>
              <code set:html={row.after} />
            </div>
          </>
        ),
      )}
    </div>
  )}
</figure>
