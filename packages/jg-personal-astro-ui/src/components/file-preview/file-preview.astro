---
import type { IFileStatus } from '../../contracts/index.ts';

import FileStatus from '../file-status/file-status.astro';

interface Props {
  path: string;
  label?: string | undefined;
  status?: IFileStatus | undefined;
  class?: string | undefined;
}

const { path, label, status, class: className } = Astro.props;
const hasFooter = Astro.slots.has('footer');
---

<figure class:list={['min-w-0 rounded-xl border border-border bg-surface', className]}>
  <figcaption class="flex min-w-0 flex-wrap items-center gap-3 rounded-t-xl border-b border-border px-4 py-3">
    <span class="grid min-w-0 flex-1 gap-1">
      {label !== undefined && <span class="text-xs text-muted wrap-anywhere">{label}</span>}
      <span class="font-mono text-sm font-semibold wrap-anywhere">{path}</span>
    </span>
    <FileStatus status={status} />
    {Astro.slots.has('header-actions') && (
      <div class="flex min-w-0 max-w-full flex-wrap items-center gap-2">
        <slot name="header-actions" />
      </div>
    )}
  </figcaption>
  <div class:list={['min-w-0 bg-code p-4', !hasFooter && 'rounded-b-xl']}>
    <slot />
  </div>
  {hasFooter && (
    <div class="min-w-0 rounded-b-xl border-t border-border p-4">
      <slot name="footer" />
    </div>
  )}
</figure>
