---
import { highlightToHtml } from '../../highlighting/index.ts';
import type { ICopyButtonDisplay } from '../../code-window/index.ts';
import { renderCodeWindowHeader } from './code-window.ts';

interface Props {
  class?: string | undefined;
  code: string;
  // shows a copy button in the header. Defaults to true
  copy?: boolean | undefined;
  copyDisplay?: ICopyButtonDisplay | undefined;
  // the language, such as 'ts', which the header shows when there's no title
  lang: string;
  // a file name or caption for the header, such as 'vite.config.ts'
  title?: string | undefined;
}

const { class: className, code, copy = true, copyDisplay, lang, title } = Astro.props;
const html = await highlightToHtml(code, lang);
---

{/* a code window, styled by contract.css: dark in both themes, with the dark syntax colours */}
<figure
  class:list={['jg-code-window', className]}
  data-code-window
>
  <Fragment set:html={renderCodeWindowHeader({ caption: title ?? lang, copy, copyDisplay })} />
  <Fragment set:html={html} />
</figure>

<script>
  import { registerCopyButtons } from '../copy-button/copy-behavior.ts';

  registerCopyButtons();
</script>
