---
import { highlightToHtml } from '../../highlighting/index.ts';
import CopyButton from '../copy-button/copy-button.astro';

interface Props {
  class?: string | undefined;
  code: string;
  // shows a copy button in the header. Defaults to true
  copy?: boolean | undefined;
  // the language, such as 'ts', which the header shows when there's no title
  lang: string;
  // a file name or caption for the header, such as 'vite.config.ts'
  title?: string | undefined;
}

const { class: className, code, copy = true, lang, title } = Astro.props;
const html = await highlightToHtml(code, lang);
---

<figure
  class:list={['min-w-0 rounded-xl border border-border bg-code', className]}
  data-code-block
>
  <figcaption class="flex min-h-10 items-center justify-between gap-3 border-b border-border py-1 pr-1.5 pl-4">
    <span class="truncate font-mono text-xs text-muted">{title ?? lang}</span>
    {copy && (
      <CopyButton
        text={code}
        context={title === undefined ? 'code' : title}
      />
    )}
  </figcaption>
  <div
    class="text-[0.8125rem] leading-6 sm:text-sm [&_pre]:overflow-x-auto [&_pre]:bg-transparent! [&_pre]:px-4 [&_pre]:py-3.5 [&_pre]:outline-offset-[-2px]"
    set:html={html}
  />
</figure>
