---
import { renderNewTabMarker } from './new-tab-marker-markup.ts';

interface Props {
  // shows the arrow; the notice for screen readers always renders
  icon?: boolean | undefined;
}

const { icon = true } = Astro.props;
---

{/* the same markup externalLinkPlugin adds to Markdown links, from one renderer */}
<Fragment set:html={renderNewTabMarker({ icon })} />
