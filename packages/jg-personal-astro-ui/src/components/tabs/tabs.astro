---
// one tab: its id names the slot that holds its panel
interface ITab {
  id: string;
  label: string;
}

interface Props {
  class?: string | undefined;
  // a prefix for the tab and panel ids, unique on the page
  id: string;
  // the tab list's accessible name
  label: string;
  // remembers the choice in localStorage under this key, and syncs it across the page's tabs
  storageKey?: string | undefined;
  tabs: readonly ITab[];
  // 'default' on the page, 'terminal' inside a dark terminal panel
  variant?: 'default' | 'terminal' | undefined;
}

const { class: className, id, label, storageKey, tabs, variant = 'default' } = Astro.props;
const panels = await Promise.all(
  tabs.map(async (tab) => ({ ...tab, html: await Astro.slots.render(tab.id) })),
);
---

<div
  class:list={['min-w-0', className]}
  data-tabs
  data-tabs-storage-key={storageKey}
>
  <div
    class:list={[
      'flex min-w-0 items-center gap-1 overflow-x-auto overflow-y-hidden',
      variant === 'terminal'
        ? 'border-b border-terminal-foreground/15 px-2 py-1.5'
        : 'shadow-[inset_0_-1px_0_var(--jg-border)]',
    ]}
    data-tab-strip
  >
    <div
      role="group"
      aria-label={label}
      class="flex min-w-max gap-1"
      data-tab-list
    >
      {tabs.map((tab) => (
        <a
          href={'#' + encodeURIComponent(id + '-panel-' + tab.id)}
          id={id + '-tab-' + tab.id}
          data-tab-id={tab.id}
          class:list={[
            'inline-flex shrink-0 items-center font-mono text-xs font-semibold no-underline transition-colors pointer-coarse:min-h-11',
            variant === 'terminal'
              ? 'rounded-md px-2.5 py-1.5 text-terminal-foreground/60 hover:text-terminal-foreground focus-visible:outline-terminal-accent aria-selected:bg-terminal-foreground/10 aria-selected:text-terminal-foreground'
              : 'border-b-2 border-transparent px-3 py-2.5 text-muted outline-offset-[-2px] hover:text-foreground aria-selected:border-foreground aria-selected:text-foreground',
          ]}
        >
          {tab.label}
        </a>
      ))}
    </div>
    <slot name="actions" />
  </div>
  {panels.map((panel) => (
    <div
      role="region"
      id={id + '-panel-' + panel.id}
      aria-labelledby={id + '-label-' + panel.id}
      data-tab-panel={panel.id}
      class="scroll-mt-24"
    >
      <p
        id={id + '-label-' + panel.id}
        data-tab-panel-label
        class="mt-4 mb-2 font-mono text-sm font-semibold"
      >
        {panel.label}
      </p>
      <Fragment set:html={panel.html} />
    </div>
  ))}
</div>

<script>
  import { registerTabs } from './tabs-behavior.ts';

  registerTabs();
</script>
