---
import { Menu, X } from '@lucide/astro';

import NewTabMarker from '../new-tab-marker/new-tab-marker.astro';
import { findItemSectionId, isCurrentItem, type INavigationItem } from './navigation-items.ts';

interface Props {
  // the current page's path, which marks its item with aria-current
  currentPath?: string | undefined;
  // the home link's accessible name, such as "jg-packages home"
  homeLabel: string;
  items: readonly INavigationItem[];
  // marks the item of the section the reader is in with aria-current="location", for items that
  // link to sections of the same page, such as #about
  trackSections?: boolean | undefined;
}

const { currentPath, homeLabel, items, trackSections = false } = Astro.props;
// each item's link attributes, the same in both navigations
const links = items.map((item) => ({
  ...item,
  ariaCurrent: isCurrentItem(item, currentPath) ? ('page' as const) : undefined,
  rel: item.external === true ? 'noreferrer' : undefined,
  sectionId: trackSections ? findItemSectionId(item, currentPath) : undefined,
  target: item.external === true ? '_blank' : undefined,
}));
const hasActions = Astro.slots.has('actions');
const hasMobileActions = Astro.slots.has('mobile-actions');
---

{/* named, so it stays still while the page under it crossfades to the next */}
<header
  class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-md [view-transition-name:jg-site-header]"
  data-track-sections={trackSections ? '' : undefined}
>
  <div class="jg-container flex min-h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="min-w-0 no-underline"
      aria-label={homeLabel}
    >
      <slot name="brand" />
    </a>

    <div class="flex items-center gap-2 md:gap-1">
      <nav
        class="hidden items-center gap-1 md:flex"
        aria-label="Primary navigation"
      >
        {links.map(({ ariaCurrent, external, href, label, rel, sectionId, target }) => (
          <a
            href={href}
            class="rounded-full px-3 py-2 text-sm font-medium text-muted no-underline transition-colors hover:bg-secondary hover:text-foreground aria-[current=location]:text-foreground aria-[current=page]:text-foreground"
            aria-current={ariaCurrent}
            target={target}
            rel={rel}
            data-section-link={sectionId}
          >
            {label}
            {external === true && <NewTabMarker />}
          </a>
        ))}
      </nav>
      {/* search shows at every width; on narrow screens, the menu holds mobile-actions instead */}
      <slot name="search" />
      {hasActions && (
        <div class="hidden items-center gap-1 md:flex">
          <slot name="actions" />
        </div>
      )}

      <details
        class="group relative md:hidden"
        data-site-menu
      >
        <summary
          class="flex size-10 list-none items-center justify-center rounded-full border border-border-strong marker:content-none [&::-webkit-details-marker]:hidden"
          aria-label="Navigation menu"
        >
          <Menu
            class="size-5 group-open:hidden"
            aria-hidden="true"
          />
          <X
            class="hidden size-5 group-open:block"
            aria-hidden="true"
          />
        </summary>
        <div class="absolute right-0 mt-2 w-[min(19rem,calc(100vw-2rem))] rounded-xl border border-border bg-surface p-3 shadow-raised">
          <nav
            class="grid gap-1"
            aria-label="Mobile navigation"
          >
            {links.map(({ ariaCurrent, external, href, label, rel, sectionId, target }) => (
              <a
                href={href}
                class="rounded-md px-3 py-2.5 text-sm font-semibold no-underline hover:bg-secondary aria-[current=location]:bg-secondary aria-[current=page]:bg-secondary"
                aria-current={ariaCurrent}
                target={target}
                rel={rel}
                data-section-link={sectionId}
              >
                {label}
                {external === true && <NewTabMarker />}
              </a>
            ))}
          </nav>
          {hasMobileActions && (
            <div class="mt-3 flex items-center gap-2 border-t border-border pt-3">
              <slot name="mobile-actions" />
            </div>
          )}
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  import { registerSectionTracking } from './section-tracking-behavior.ts';

  // follows the reader's section when the site asked for it
  document
    .querySelectorAll<HTMLElement>('header[data-track-sections]')
    .forEach((header) => registerSectionTracking(header));

  // closes the mobile menu once a link inside it is chosen, on Escape, which returns focus to the
  // menu button, and on a click outside it
  document.querySelectorAll<HTMLDetailsElement>('[data-site-menu]').forEach((menu) => {
    const summary = menu.querySelector<HTMLElement>('summary');

    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        menu.open = false;
      }
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    });
  });
</script>
