---
import type { IProcessStatus } from '../../contracts/index.ts';

import ProcessStatus from '../process-status/process-status.astro';

interface Props {
  date: string;
  dateTime?: string | undefined;
  label: string;
  status?: IProcessStatus | undefined;
  class?: string | undefined;
}

const { date, dateTime, label, status, class: className } = Astro.props;
const hasContent = Astro.slots.has('content') || Astro.slots.has('default');
---

<li
  aria-current={status === 'current' ? 'true' : undefined}
  class:list={[
    'relative min-w-0 border-l border-border pb-8 pl-5 last:border-transparent last:pb-0 before:absolute before:top-3 before:-left-[4.5px] before:size-2 before:rounded-full before:bg-border-strong sm:pl-8 sm:before:top-4',
    className,
  ]}
>
  <article
    aria-label={label}
    class="grid min-w-0 gap-x-4 gap-y-3 sm:grid-cols-[10rem_minmax(0,1fr)]"
  >
    <div class="flex min-h-8 min-w-0 items-center font-mono text-xs text-muted wrap-anywhere sm:min-h-10">
      {dateTime === undefined ? <span>{date}</span> : <time datetime={dateTime}>{date}</time>}
    </div>
    <header class="flex min-h-8 min-w-0 flex-wrap items-center gap-3 sm:min-h-10">
      <div class="min-w-0 flex-1 font-semibold wrap-anywhere">
        <slot name="label">{label}</slot>
      </div>
      <ProcessStatus status={status} />
    </header>
    {hasContent && (
      <div class="min-w-0 max-w-prose wrap-anywhere sm:col-start-2">
        <slot name="content">
          <slot />
        </slot>
      </div>
    )}
    {Astro.slots.has('action') && (
      <div class="flex min-w-0 flex-wrap items-center gap-3 sm:col-start-2">
        <slot name="action" />
      </div>
    )}
  </article>
</li>
