---
import { buildTableClasses, buildTableRegionAttributes } from './table-classes.ts';

interface Props {
  // what the table holds, read by screen readers and shown above it
  caption?: string | undefined;
  // shows the caption to screen readers only
  captionHidden?: boolean | undefined;
  class?: string | undefined;
  // makes the wrapper a focusable region with this name, so keyboard users can scroll a wide table
  scrollLabel?: string | undefined;
  // pins each row's first cell while the rest scroll sideways under it
  stickyFirstColumn?: boolean | undefined;
}

const { caption, captionHidden, class: className, scrollLabel, stickyFirstColumn } = Astro.props;
const classes = buildTableClasses({
  captionHidden,
  scrollable: scrollLabel !== undefined,
  stickyFirstColumn,
});
---

{/*
 * a data table that scrolls sideways on its own when it's wider than the page; the default slot
 * holds its colgroup, thead, and tbody
 */}
<div
  class:list={[classes.wrapper, className]}
  {...buildTableRegionAttributes(scrollLabel)}
>
  <table class={classes.table}>
    {caption !== undefined && <caption class={classes.caption}>{caption}</caption>}
    <slot />
  </table>
</div>
