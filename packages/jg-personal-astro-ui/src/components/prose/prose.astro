---
import type { HTMLAttributes } from 'astro/types';

import type { ITitleFont, ITitleVariant } from '../../typography/index.ts';

type Props = {
  class?: string | undefined;
  titleFont?: ITitleFont | undefined;
  titleVariant?: ITitleVariant | undefined;
} & Omit<HTMLAttributes<'div'>, 'class'>;

const { class: className, titleFont, titleVariant = 'page', ...attributes } = Astro.props;
---

{/* styled by prose.css, which the site imports with its stylesheet */}
<div
  class:list={['jg-prose', className]}
  {...attributes}
  data-jg-title-font={titleFont}
  data-jg-title-variant={titleVariant}
>
  <slot />
</div>

<script>
  import { registerCopyButtons } from '../copy-button/copy-behavior.ts';

  // the copy buttons of the code windows codeWindowPlugin puts in Markdown
  registerCopyButtons();
</script>
