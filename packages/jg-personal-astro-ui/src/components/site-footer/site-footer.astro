---
import NewTabMarker from '../new-tab-marker/new-tab-marker.astro';

// a footer link. An external one opens in a new tab with an arrow, unless externalIcon is false
interface IFooterLink {
  external?: boolean | undefined;
  externalIcon?: boolean | undefined;
  href: string;
  label: string;
}

// a column of footer links
interface IFooterColumn {
  links: readonly IFooterLink[];
  title: string;
}

interface Props {
  columns: readonly IFooterColumn[];
  // short lines under the columns, such as the domain and the license
  notes?: readonly string[] | undefined;
}

const { columns, notes = [] } = Astro.props;
---

<footer class="border-t border-border py-12 sm:py-16">
  {/* on wide screens, the brand and every column share one row, whatever the number of columns */}
  <div class="jg-container grid gap-10 sm:grid-cols-2 lg:auto-cols-max lg:grid-flow-col lg:grid-cols-[minmax(0,1fr)] lg:gap-16">
    <div class="max-w-md">
      <slot name="brand" />
      <div class="mt-4 text-sm leading-6 text-muted">
        <slot name="about" />
      </div>
    </div>
    {columns.map(({ links, title }) => (
      <nav
        class="grid min-w-40 content-start gap-2 text-sm"
        aria-label={title}
      >
        <p class="mb-2 font-mono text-xs font-bold text-muted uppercase">{title}</p>
        {links.map(({ external = false, externalIcon = true, href, label }) => (
          <a
            href={href}
            class="w-fit underline-offset-4 hover:underline"
            target={external ? '_blank' : undefined}
            rel={external ? 'noreferrer' : undefined}
          >
            {label}
            {external && <NewTabMarker icon={externalIcon} />}
          </a>
        ))}
      </nav>
    ))}
  </div>
  {notes.length > 0 && (
    <div class="jg-container mt-12 flex flex-wrap gap-x-6 gap-y-1 border-t border-border pt-6 font-mono text-xs text-muted">
      {notes.map((note) => (
        <span>{note}</span>
      ))}
    </div>
  )}
</footer>
