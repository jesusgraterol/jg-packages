---
import { serializeStructuredData } from '../../seo/index.ts';
import {
  buildHeadTags,
  type IHeadAlternate,
  type IHeadArticle,
  type IHeadIcon,
  type IHeadProfile,
  type IOpenGraphImage,
  type IOpenGraphType,
} from './head-meta.ts';
import { SPECULATION_RULES } from './speculation-rules.ts';

interface Props {
  // another version of the page offered to agents, such as its Markdown or plain text
  alternate?: IHeadAlternate | undefined;
  // the article:* details of a page of type 'article'
  article?: IHeadArticle | undefined;
  author?: string | undefined;
  // the page's own URL. A noindex page has none, which would contradict noindex
  canonicalUrl?: string | undefined;
  description: string;
  // the favicons and home screen icons, such as an SVG favicon or an ICO with its sizes
  icons?: readonly IHeadIcon[] | undefined;
  // the language of the page's Open Graph locale, such as en_US
  locale?: string | undefined;
  // the llms.txt that describes the site for agents
  llmsTextUrl?: string | undefined;
  noIndex?: boolean | undefined;
  openGraphImage?: IOpenGraphImage | undefined;
  // what the page is, for Open Graph. Defaults to 'website'
  openGraphType?: IOpenGraphType | undefined;
  // the profile:* details of a page of type 'profile'
  profile?: IHeadProfile | undefined;
  siteName: string;
  // JSON-LD for the page, serialized with < escaped so it can't close the script element
  structuredData?: unknown;
  // the browser chrome colour of each theme
  themeColors?: { light: string; dark: string } | undefined;
  title: string;
  // the author's handle on X, such as @jesusgraterol
  twitterCreator?: string | undefined;
}

const {
  alternate,
  article,
  author,
  canonicalUrl,
  description,
  icons,
  locale = 'en_US',
  llmsTextUrl,
  noIndex = false,
  openGraphImage,
  openGraphType = 'website',
  profile,
  siteName,
  structuredData,
  themeColors,
  title,
  twitterCreator,
} = Astro.props;
const headTags = buildHeadTags({
  alternate,
  article,
  canonicalUrl,
  description,
  icons,
  llmsTextUrl,
  locale,
  noIndex,
  openGraphImage,
  openGraphType,
  profile,
  siteName,
  title,
  twitterCreator,
});
const serializedStructuredData =
  structuredData === undefined ? undefined : serializeStructuredData(structuredData);
---

<meta charset="UTF-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1"
/>
<meta
  name="generator"
  content={Astro.generator}
/>
<title>{title}</title>
<meta
  name="description"
  content={description}
/>
{author !== undefined && (
  <meta
    name="author"
    content={author}
  />
)}
<meta
  name="robots"
  content={noIndex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
/>
{themeColors !== undefined && (
  <>
    <meta
      name="theme-color"
      content={themeColors.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColors.dark}
      media="(prefers-color-scheme: dark)"
    />
  </>
)}
{headTags.map(({ attributes, element }) =>
  element === 'link' ? <link {...attributes} /> : <meta {...attributes} />,
)}
{serializedStructuredData !== undefined && (
  <script
    is:inline
    type="application/ld+json"
    set:html={serializedStructuredData}
  />
)}
<script
  is:inline
  type="speculationrules"
  set:html={JSON.stringify(SPECULATION_RULES)}
/>
<slot />
