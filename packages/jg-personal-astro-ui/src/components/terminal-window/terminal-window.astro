---
import type { ICopyButtonDisplay } from '../../code-window/index.ts';

import { renderCodeWindowHeader } from '../code-block/code-window.ts';

interface Props {
  class?: string | undefined;
  // copies the element with this id; context completes the copy button's accessible name, such as
  // "install command"
  copy?: { context: string; sourceId: string } | undefined;
  copyDisplay?: ICopyButtonDisplay | undefined;
  // the window's caption, such as 'Terminal'
  title: string;
  // lets a long title, such as a sentence, wrap onto more lines instead of ending in an ellipsis
  wrapTitle?: boolean | undefined;
}

const { class: className, copy, copyDisplay, title, wrapTitle } = Astro.props;
---

{/*
 * a terminal window: the code window's dark frame, dots, and caption, around a shell session or
 * output in the default slot, with a copy button when given what to copy
 */}
<figure
  class:list={['jg-code-window', className]}
  data-code-window
>
  <Fragment
    set:html={renderCodeWindowHeader({
      caption: title,
      copy: copy !== undefined,
      copyDisplay,
      copySource: copy,
      wrapCaption: wrapTitle,
    })}
  />
  <div class="overflow-x-auto px-4 py-3.5 font-mono text-[0.8125rem] leading-6 sm:text-sm">
    <slot />
  </div>
</figure>

<script>
  import { registerCopyButtons } from '../copy-button/copy-behavior.ts';

  registerCopyButtons();
</script>
