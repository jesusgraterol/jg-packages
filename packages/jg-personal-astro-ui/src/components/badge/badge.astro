---
// the look of each variant
const VARIANT_CLASSES = {
  default: 'border-primary bg-primary text-primary-foreground',
  secondary: 'border-transparent bg-secondary text-foreground',
  success: 'border-success/35 bg-success/10 text-success',
  warning: 'border-warning/40 bg-warning/10 text-warning',
  danger: 'border-danger/35 bg-danger/10 text-danger',
  outline: 'border-border-strong text-muted',
} as const;

interface Props {
  class?: string | undefined;
  variant?: keyof typeof VARIANT_CLASSES | undefined;
}

const { class: className, variant = 'secondary' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 font-mono text-xs leading-5 font-semibold whitespace-nowrap',
    VARIANT_CLASSES[variant],
    className,
  ]}
>
  <slot />
</span>
