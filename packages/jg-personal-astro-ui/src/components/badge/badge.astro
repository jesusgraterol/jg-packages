---
import type { HTMLAttributes } from 'astro/types';

import { BADGE_DOT_CLASSES, buildBadgeClasses, type IBadgeVariant } from './badge-classes.ts';

type Props = {
  class?: string | undefined;
  // a status dot before the label, in its colour
  dot?: boolean | undefined;
  // sets the label in the mono font. Defaults to true
  mono?: boolean | undefined;
  variant?: IBadgeVariant | undefined;
} & Omit<HTMLAttributes<'span'>, 'class'>;

const { class: className, dot = false, mono, variant, ...attributes } = Astro.props;
---

<span
  class:list={[buildBadgeClasses(variant, mono), className]}
  {...attributes}
>
  {dot && (
    <span
      class={BADGE_DOT_CLASSES}
      aria-hidden="true"
    ></span>
  )}
  <slot />
</span>
