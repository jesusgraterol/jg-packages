---
import { Search } from '@lucide/astro';

import Button from '../button/button.astro';
import Dialog from '../dialog/dialog.astro';
import Kbd from '../kbd/kbd.astro';

interface Props {
  class?: string | undefined;
  // the dialog's id, which its trigger and any other data-dialog-open element name. Defaults to
  // 'search'
  id?: string | undefined;
  // where the site serves Pagefind's script. Defaults to '/pagefind/pagefind.js'
  pagefindPath?: string | undefined;
  title?: string | undefined;
  inputLabel?: string | undefined;
  placeholder?: string | undefined;
}

const {
  class: className,
  id = 'search',
  pagefindPath = '/pagefind/pagefind.js',
  title = 'Search',
  inputLabel = 'Search the site',
  placeholder = 'Search the packages',
} = Astro.props;
---

{/* the trigger: a button that names the shortcut, which opens the dialog too */}
<button
  type="button"
  class:list={[
    'inline-flex min-h-9 items-center justify-center gap-2 rounded-full border border-border-strong px-3 text-sm text-muted transition-colors hover:bg-secondary hover:text-foreground max-sm:size-10 max-sm:px-0',
    className,
  ]}
  data-dialog-open={id}
  aria-keyshortcuts="/ Control+K Meta+K"
>
  <Search
    class="size-4"
    aria-hidden="true"
  />
  {/* below 640 px the icon keeps the configured accessible name */}
  <span class="max-sm:sr-only">{title}</span>
  {/* aria-keyshortcuts names the shortcut, so the key stays out of the button's name */}
  <span
    class="hidden sm:inline-flex"
    aria-hidden="true"
  >
    <Kbd>/</Kbd>
  </span>
</button>

<Dialog
  id={id}
  title={title}
>
  <div
    data-search-dialog
    data-pagefind-path={pagefindPath}
  >
    <label
      class="sr-only"
      for={`${id}-input`}
    >
      {inputLabel}
    </label>
    <input
      id={`${id}-input`}
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder={placeholder}
      autofocus
      class="w-full rounded-lg border border-border-strong bg-surface px-3 py-2 text-base text-foreground placeholder:text-muted pointer-fine:text-sm"
      data-search-input
    />
    <p
      class="mt-3 text-xs text-muted"
      aria-live="polite"
      aria-atomic="true"
      role="status"
      data-search-status
    ></p>
    <ul
      class="mt-2 grid gap-1"
      data-search-results
    ></ul>
    <Button
      class="mt-3"
      variant="outline"
      hidden
      data-search-retry
    >
      Try again
    </Button>
  </div>
</Dialog>

<script>
  import { registerSearchDialogs } from './search-behavior.ts';

  registerSearchDialogs();
</script>
