---
import type { HTMLAttributes } from 'astro/types';

import NewTabMarker from '../new-tab-marker/new-tab-marker.astro';
import { buildButtonClasses, type IButtonSize, type IButtonVariant } from './button-classes.ts';

type Props = {
  class?: string | undefined;
  // opens the link in a new tab, with an arrow icon, the new-tab notice, and no referrer
  external?: boolean | undefined;
  // shows the arrow on an external link. Defaults to true
  externalIcon?: boolean | undefined;
  // renders a link instead of a button, which takes the same global and ARIA attributes
  href?: string | undefined;
  size?: IButtonSize | undefined;
  variant?: IButtonVariant | undefined;
} & Omit<HTMLAttributes<'button'>, 'class'> &
  // a link's own attributes, such as download, which apply when the button has an href
  Pick<HTMLAttributes<'a'>, 'download' | 'hreflang' | 'ping' | 'referrerpolicy'>;

const {
  class: className,
  external = false,
  externalIcon = true,
  href,
  size = 'default',
  type = 'button',
  variant = 'default',
  ...attributes
} = Astro.props;
const classes = buildButtonClasses(size, variant, className);
---

{href === undefined ? (
  <button
    type={type}
    class={classes}
    {...attributes}
  >
    <slot />
  </button>
) : (
  <a
    href={href}
    class={classes}
    target={external ? '_blank' : undefined}
    rel={external ? 'noreferrer' : undefined}
    {...attributes}
  >
    <slot />
    {external && <NewTabMarker icon={externalIcon} />}
  </a>
)}
