---
import type { HTMLAttributes } from 'astro/types';

import { buildIconTileClasses, type IIconTileSize } from './icon-tile-classes.ts';

type Props = {
  class?: string | undefined;
  // 'card' leads a card's top row, 'header' opens a page. Defaults to 'card'
  size?: IIconTileSize | undefined;
} & Omit<HTMLAttributes<'span'>, 'class'>;

const { class: className, size, ...attributes } = Astro.props;
---

{/* decorative: the thing it stands for is always named next to it. The icon goes in the slot */}
<span
  class:list={[buildIconTileClasses(size), className]}
  aria-hidden="true"
  {...attributes}
>
  <slot />
</span>
