---
import type { HTMLAttributes } from 'astro/types';

import NewTabMarker from '../new-tab-marker/new-tab-marker.astro';

type Props = {
  class?: string | undefined;
  // opens the link in a new tab, with an arrow icon, the new-tab notice, and no referrer
  external?: boolean | undefined;
  href: string;
} & Omit<HTMLAttributes<'a'>, 'class' | 'href' | 'rel' | 'target'>;

const { class: className, external = false, href, ...attributes } = Astro.props;
// trimmed, so the line breaks around the text in the page's markup never space out the arrow
const content = (await Astro.slots.render('default')).trim();
---

<a
  href={href}
  class:list={[
    'font-medium underline decoration-current/40 decoration-[0.08em] underline-offset-[0.18em] transition-colors hover:decoration-current',
    className,
  ]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
  {...attributes}
>
  <Fragment set:html={content} />
  {external && <NewTabMarker />}
</a>
