---
interface Props {
  // sizing and layout classes for the mark, such as size-8
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

{/* the Agentic Coding mark, two code chevrons meeting at a node, in fixed colors so it reads the
  same in both themes. Its paths match agentic-coding-mark.svg, which the sites' favicons and
  social images come from */}
<svg
  class={className}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect
    width="64"
    height="64"
    rx="16"
    fill="#111111"
  ></rect>
  <path
    d="M27 18 13 32l14 14"
    stroke="#f4f6f1"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path
    d="m37 18 14 14-14 14"
    stroke="#76c8ad"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path
    d="m32 24 8 8-8 8-8-8 8-8Z"
    fill="#ef6047"
  ></path>
</svg>
