---
import { renderCopyButton, type ICopyButtonOptions } from './copy-button-markup.ts';

// what the button copies (text, an element's text by sourceId, or its code window's code), its
// context for screen readers and guidance, its label, presentation, tone, and size
type Props = ICopyButtonOptions;
---

<Fragment set:html={renderCopyButton(Astro.props)} />

<script>
  import { registerCopyButtons } from './copy-behavior.ts';

  registerCopyButtons();
</script>
