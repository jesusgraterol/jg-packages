---
import { ChevronRight } from '@lucide/astro';

import { buildBreadcrumbListClasses, type IBreadcrumbAlign } from './breadcrumb-classes.ts';

// one step of the trail; the last one is the current page
interface IBreadcrumbItem {
  href: string;
  name: string;
}

interface Props {
  // centers the trail, as over a centered page header. Defaults to 'start'
  align?: IBreadcrumbAlign | undefined;
  class?: string | undefined;
  items: readonly IBreadcrumbItem[];
}

const { align, class: className, items } = Astro.props;
---

<nav
  aria-label="Breadcrumb"
  class={className}
>
  <ol class={buildBreadcrumbListClasses(align)}>
    {items.map(({ href, name }, index) => {
      const isCurrentPage = index === items.length - 1;
      return (
        <li class="flex min-w-0 items-center gap-1.5">
          {index > 0 && (
            <ChevronRight
              class="size-3.5 shrink-0"
              aria-hidden="true"
            />
          )}
          {isCurrentPage ? (
            <span
              class="truncate text-foreground"
              aria-current="page"
            >
              {name}
            </span>
          ) : (
            <a
              class="underline-offset-4 hover:text-foreground hover:underline"
              href={href}
            >
              {name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
