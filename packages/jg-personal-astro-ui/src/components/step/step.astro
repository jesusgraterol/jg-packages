---
import type { IProcessStatus } from '../../contracts/index.ts';

import ProcessStatus from '../process-status/process-status.astro';

interface Props {
  title: string;
  number?: string | number | undefined;
  status?: IProcessStatus | undefined;
  class?: string | undefined;
}

const { title, number, status, class: className } = Astro.props;
const hasContent = Astro.slots.has('content') || Astro.slots.has('default');
---

<li
  aria-current={status === 'current' ? 'step' : undefined}
  class:list={[
    'relative min-w-0 border-l border-border pb-8 pl-5 last:border-transparent last:pb-0 before:absolute before:top-3 before:-left-[4.5px] before:size-2 before:rounded-full before:bg-border-strong sm:pl-8 sm:before:top-4',
    className,
  ]}
>
  <article
    aria-label={title}
    class="min-w-0"
  >
    <header class="flex min-h-8 min-w-0 flex-wrap items-center gap-3 sm:min-h-10">
      {number !== undefined && (
        <span class="flex min-h-8 min-w-8 max-w-12 shrink-0 items-center justify-center rounded-full border border-border bg-surface px-2 py-1 text-center font-mono text-xs wrap-anywhere sm:min-h-10 sm:min-w-10">
          {number}
        </span>
      )}
      <div class="min-w-0 flex-1 font-semibold wrap-anywhere">
        <slot name="title">{title}</slot>
      </div>
      <ProcessStatus status={status} />
    </header>
    {hasContent && (
      <div class="mt-3 min-w-0 max-w-prose wrap-anywhere">
        <slot name="content">
          <slot />
        </slot>
      </div>
    )}
    {Astro.slots.has('action') && (
      <div class="mt-4 flex min-w-0 flex-wrap items-center gap-3">
        <slot name="action" />
      </div>
    )}
  </article>
</li>
