---
import Button from 'jg-personal-astro-ui/button';
import Container from 'jg-personal-astro-ui/container';
import CopyButton from 'jg-personal-astro-ui/copy-button';
import Dialog from 'jg-personal-astro-ui/dialog';
import PackageManagerTabs from 'jg-personal-astro-ui/package-manager-tabs';
import PageHeader from 'jg-personal-astro-ui/page-header';
import SearchDialog from 'jg-personal-astro-ui/search-dialog';
import SegmentedControl from 'jg-personal-astro-ui/segmented-control';
import Tabs from 'jg-personal-astro-ui/tabs';

import GalleryLayout from '../layouts/gallery-layout.astro';
---

<GalleryLayout
  title="Interactions"
  clientRouter
>
  <PageHeader
    title="Interactions"
    eyebrow="Browser behavior"
    lede="Keyboard navigation, multiple instances, and visible feedback on real rendered components."
  />
  <Container class="pb-16">
    <section
      class="gallery-example"
      data-example="tabs"
      aria-labelledby="tabs-title"
    >
      <h2 id="tabs-title">Independent and nested tabs</h2>
      <Tabs
        id="example-tabs"
        label="Example language"
        tabs={[
          { id: 'typescript', label: 'TypeScript' },
          { id: 'javascript', label: 'JavaScript with a longer label' },
        ]}
      >
        <div
          slot="typescript"
          class="py-5"
        >
          <p>TypeScript example panel.</p>
          <Tabs
            id="nested-tabs"
            label="Nested detail"
            tabs={[
              { id: 'overview', label: 'Overview' },
              { id: 'details', label: 'Details' },
            ]}
          >
            <p
              slot="overview"
              class="py-4"
            >
              Nested overview.
            </p>
            <p
              slot="details"
              class="py-4"
            >
              Nested details.
            </p>
          </Tabs>
        </div>
        <p
          slot="javascript"
          class="py-5"
        >
          JavaScript example panel.
        </p>
      </Tabs>
    </section>
    <section
      class="gallery-example"
      aria-labelledby="wide-tabs-title"
    >
      <h2 id="wide-tabs-title">Long tab labels and an actions slot</h2>
      <Tabs
        id="wide-tabs"
        label="Scrollable reference"
        storageKey={'gallery-reference["choice"]'}
        tabs={[
          { id: 'overview', label: 'Overview of the package' },
          { id: 'configuration', label: 'Configuration and installation' },
          { id: 'extension', label: 'Extending the public API' },
          { id: 'recovery', label: 'Troubleshooting and recovery' },
        ]}
      >
        <p
          slot="overview"
          class="py-5"
        >
          Reference overview content.
        </p>
        <p
          slot="configuration"
          class="py-5"
        >
          Reference configuration content.
        </p>
        <p
          slot="extension"
          class="py-5"
        >
          Reference extension content.
        </p>
        <p
          slot="recovery"
          class="py-5"
        >
          Reference recovery content.
        </p>
        <CopyButton
          slot="actions"
          text="reference example"
          context="tab actions example"
          tone="outline"
        />
      </Tabs>
    </section>
    <section
      class="gallery-example"
      data-example="package-manager-tabs"
      aria-labelledby="install-title"
    >
      <h2 id="install-title">Synchronized install commands</h2>
      <div class="grid gap-4">
        <PackageManagerTabs
          id="install-main"
          packages="jg-site"
          storageKey="gallery-package-manager"
        />
        <div data-icon-package-manager>
          <PackageManagerTabs
            id="install-dev"
            packages="jg-playwright"
            dev
            copyDisplay="icon"
            storageKey="gallery-package-manager"
          />
        </div>
      </div>
    </section>
    <section
      class="gallery-example"
      data-example="segmented-control"
      aria-labelledby="segmented-title"
    >
      <h2 id="segmented-title">Native choices</h2>
      <SegmentedControl
        name="gallery-density"
        legend="Reading density"
        options={[
          { value: 'comfortable', label: 'Comfortable' },
          { value: 'compact', label: 'Compact' },
        ]}
      />
    </section>
    <section
      class="gallery-example"
      data-example="dialog"
      aria-labelledby="dialogs-title"
    >
      <h2 id="dialogs-title">Dialogs</h2>
      <div class="flex flex-wrap gap-3">
        <Button data-dialog-open="example-dialog">Open example dialog</Button>
        <Button
          variant="outline"
          data-dialog-open="long-dialog"
        >
          Open long dialog
        </Button>
        <Button
          variant="outline"
          data-dialog-open="mobile-dialog"
        >
          Open mobile reference
        </Button>
      </div>
      <Dialog
        id="example-dialog"
        title="Example dialog"
      >
        <p>A native modal with a named close action and focus return.</p>
        <Button
          class="mt-4"
          data-dialog-close
        >
          Finish
        </Button>
      </Dialog>
      <Dialog
        id="mobile-dialog"
        title="Mobile reference"
        size="lg"
        mobilePresentation="fullscreen"
        isOverlayCloseEnabled={false}
        initialFocus="#mobile-dialog-input"
      >
        <label
          class="mb-2 block text-sm font-medium"
          for="mobile-dialog-input"
        >
          Reference note
        </label>
        <input
          id="mobile-dialog-input"
          type="text"
          autocomplete="off"
          inputmode="text"
          enterkeyhint="done"
          placeholder="e.g. Installation notes"
          class="w-full rounded-lg border border-border-strong bg-surface px-3 py-2 text-base"
        />
        <div class="my-5 flex flex-wrap gap-4">
          <Button data-dialog-open="nested-dialog">Open nested reference</Button>
          <a
            class="underline"
            href="/interactions/?dialog-navigation=1"
          >
            Continue browsing
          </a>
        </div>
        {Array.from({ length: 16 }, (_, index) => (
          <p class="my-5">
            Reference section {index + 1}. The title and close action remain visible while this
            content scrolls.
          </p>
        ))}
        <Button data-dialog-close>Done reading</Button>
      </Dialog>
      <Dialog
        id="nested-dialog"
        title="Nested reference"
        size="sm"
        mobilePresentation="fullscreen"
      >
        <p>A second native modal retains the parent dialog's scroll lock and history entry.</p>
      </Dialog>
      <Dialog
        id="long-dialog"
        title="Long content"
      >
        <div class="space-y-5">
          {Array.from({ length: 16 }, (_, index) => (
            <p>
              Section {index + 1}. Long dialog content stays inside the scrollable body so the close
              action remains reachable.
            </p>
          ))}
        </div>
      </Dialog>
    </section>
    <section
      class="gallery-example"
      aria-labelledby="configured-search-heading"
    >
      <h2 id="configured-search-heading">Configured search</h2>
      <SearchDialog
        id="configured-search"
        title="Find documentation"
        inputLabel="Search documentation"
        placeholder="e.g. Installation"
      />
    </section>
    <section
      class="gallery-example"
      data-example="copy-button"
      aria-labelledby="copy-title"
    >
      <h2 id="copy-title">Copy sources and failures</h2>
      <p
        id="copy-source"
        class="mb-4 font-mono"
      >
        gallery source text
      </p>
      <div class="flex flex-wrap gap-3">
        <CopyButton
          text="gallery clipboard text"
          context="literal example"
          tone="outline"
          size="md"
        />
        <CopyButton
          sourceId="copy-source"
          context="source example"
          tone="outline"
          size="md"
        />
        <CopyButton
          sourceId="missing-source"
          context="missing example"
          tone="outline"
          size="md"
        />
        <CopyButton
          url="/missing-copy-source.txt"
          context="unavailable document"
          tone="outline"
          size="md"
        />
        <CopyButton
          text={'Hola, 世界 <Astro> & friends\nSecond line\n'}
          context="Unicode example"
          display="icon"
          tone="outline"
          size="md"
        />
        <CopyButton
          url="/copy-example.txt"
          context="Unicode document"
          display="icon"
          tone="outline"
          size="md"
        />
      </div>
    </section>
    <section
      class="gallery-example"
      aria-labelledby="search-title"
    >
      <h2 id="search-title">Unavailable search index</h2>
      <p class="mb-4 text-muted">
        The header searches the real gallery index. This separate instance exercises the failure
        state.
      </p>
      <SearchDialog
        id="unavailable-search"
        pagefindPath="/missing-pagefind.js"
      />
    </section>
  </Container>
</GalleryLayout>
