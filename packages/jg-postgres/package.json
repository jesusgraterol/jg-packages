{
  "name": "jg-postgres",
  "version": "0.6.0",
  "description": "PostgreSQL helpers for node-postgres: safe transactions, advisory locks, SQLSTATE checks, cursor pages, and ordered lists.",
  "author": "Jesus Graterol",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./error-log": {
      "types": "./dist/error-log/index.d.ts",
      "default": "./dist/error-log/index.js"
    },
    "./record-store": {
      "types": "./dist/record-store/index.d.ts",
      "default": "./dist/record-store/index.js"
    },
    "./delivery-inbox": {
      "types": "./dist/delivery-inbox/index.d.ts",
      "default": "./dist/delivery-inbox/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "API.md",
    "RECIPES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusgraterol/jg-packages.git",
    "directory": "packages/jg-postgres"
  },
  "homepage": "https://jg-packages.jesusgraterol.dev/packages/jg-postgres/",
  "bugs": {
    "url": "https://github.com/jesusgraterol/jg-packages/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "pg",
    "node-postgres",
    "transactions",
    "advisory-locks",
    "pagination"
  ],
  "scripts": {
    "build": "node ../../internal/build-tools/src/clean-dist.ts && tsc -p tsconfig.build.json && node ../../internal/api-reference/src/write-api-markdown.ts",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "jg-crypto": "workspace:^",
    "jg-exception": "workspace:^",
    "jg-utilities": "workspace:^",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@jg-packages/eslint-config": "workspace:*",
    "@jg-packages/tsconfig": "workspace:*",
    "@jg-packages/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "4.6.7"
  }
}
