{
  "name": "jg-playwright",
  "version": "0.1.0",
  "description": "Playwright helpers for end-to-end tests: horizontal overflow, loaded assets, motion, accessibility scans, secrets, and a fake microphone.",
  "author": "Jesus Graterol",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./axe": {
      "types": "./dist/axe/index.d.ts",
      "default": "./dist/axe/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "API.md",
    "RECIPES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusgraterol/jg-packages.git",
    "directory": "packages/jg-playwright"
  },
  "homepage": "https://jg-packages.jesusgraterol.dev/packages/jg-playwright/",
  "bugs": {
    "url": "https://github.com/jesusgraterol/jg-packages/issues"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "accessibility",
    "axe"
  ],
  "scripts": {
    "build": "node ../../internal/build-tools/src/clean-dist.ts && tsc -p tsconfig.build.json && node ../../internal/api-reference/src/write-api-markdown.ts",
    "lint": "eslint .",
    "test": "pnpm test:e2e",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "jg-exception": "workspace:^"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@jg-packages/eslint-config": "workspace:*",
    "@jg-packages/tsconfig": "workspace:*",
    "@jg-packages/vitest-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
