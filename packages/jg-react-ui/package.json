{
  "name": "jg-react-ui",
  "version": "0.3.0",
  "description": "Consumer-themed React components with Moldea-derived APIs, explicit styling contracts, and reusable application behavior.",
  "author": "Jesus Graterol",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/button": {
      "types": "./dist/components/button/index.d.ts",
      "default": "./dist/components/button/index.js"
    },
    "./cn": {
      "types": "./dist/cn/index.d.ts",
      "default": "./dist/cn/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./styles.css": {
      "style": "./dist/styles/index.css",
      "default": "./dist/styles/index.css"
    },
    "./tokens.css": {
      "style": "./dist/styles/tokens.css",
      "default": "./dist/styles/tokens.css"
    },
    "./components/badge": {
      "types": "./dist/components/badge/index.d.ts",
      "default": "./dist/components/badge/index.js"
    },
    "./components/icon-tile": {
      "types": "./dist/components/icon-tile/index.d.ts",
      "default": "./dist/components/icon-tile/index.js"
    },
    "./components/alert": {
      "types": "./dist/components/alert/index.d.ts",
      "default": "./dist/components/alert/index.js"
    },
    "./components/error-feedback-provider": {
      "types": "./dist/components/error-feedback-provider/index.d.ts",
      "default": "./dist/components/error-feedback-provider/index.js"
    },
    "./components/ui-preferences-provider": {
      "types": "./dist/components/ui-preferences-provider/index.d.ts",
      "default": "./dist/components/ui-preferences-provider/index.js"
    },
    "./components/theme-provider": {
      "types": "./dist/components/theme-provider/index.d.ts",
      "default": "./dist/components/theme-provider/index.js"
    },
    "./components/toastr": {
      "types": "./dist/components/toastr/index.d.ts",
      "default": "./dist/components/toastr/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "API.md",
    "RECIPES.md",
    "errors"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusgraterol/jg-packages.git",
    "directory": "packages/jg-react-ui"
  },
  "homepage": "https://github.com/jesusgraterol/jg-packages/tree/main/packages/jg-react-ui#readme",
  "bugs": {
    "url": "https://github.com/jesusgraterol/jg-packages/issues"
  },
  "scripts": {
    "build": "node ../../internal/build-tools/src/clean-dist.ts && tsc -p tsconfig.build.json && node ../../internal/build-tools/src/copy-assets.ts 'styles/*.css' && node ../../internal/api-reference/src/write-api-markdown.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "pnpm test:unit && pnpm test:browser",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage --project unit --project \"browser (chromium)\""
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.0.8",
    "jg-utilities": "workspace:^",
    "zod": "^4.3.6",
    "jg-exception": "workspace:^",
    "zustand": "^5.0.14",
    "jg-react": "workspace:^",
    "jg-storage": "workspace:^",
    "lucide-react": "^1.8.0",
    "sonner": "^2.0.7"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@jg-packages/eslint-config": "workspace:*",
    "@jg-packages/tsconfig": "workspace:*",
    "@jg-packages/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "0.7.1",
    "cnfast": "0.0.8",
    "zod": "4.3.6",
    "zustand": "5.0.14",
    "lucide-react": "1.8.0",
    "sonner": "2.0.7"
  }
}
