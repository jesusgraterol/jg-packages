  "scripts": {
    "build": "node ../../internal/build-tools/src/clean-dist.ts && tsc -p tsconfig.build.json && node build/build.ts && node ../../internal/build-tools/src/copy-assets.ts 'styles/*.css' && node ../../internal/api-reference/src/write-api-markdown.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p build/tsconfig.json",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:browser",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage --project unit --project integration --project \"browser (chromium)\"",
    "build:viewer": "node build/build.ts",
    "test:integration": "vitest run --project integration"
  },
