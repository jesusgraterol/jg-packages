{
  "name": "jg-personal-react-ui",
  "version": "0.1.0",
  "description": "JG-branded React components and styles, sharing Moldea-derived APIs with the unbranded jg-react-ui implementation.",
  "author": "Jesus Graterol",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/button": {
      "types": "./dist/components/button/index.d.ts",
      "default": "./dist/components/button/index.js"
    },
    "./cn": {
      "types": "./dist/cn/index.d.ts",
      "default": "./dist/cn/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./styles.css": {
      "style": "./dist/styles/index.css",
      "default": "./dist/styles/index.css"
    },
    "./tokens.css": {
      "style": "./dist/styles/tokens.css",
      "default": "./dist/styles/tokens.css"
    },
    "./system-theme-fallback.css": {
      "style": "./dist/styles/system-theme-fallback.css",
      "default": "./dist/styles/system-theme-fallback.css"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "API.md",
    "RECIPES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusgraterol/jg-packages.git",
    "directory": "packages/jg-personal-react-ui"
  },
  "homepage": "https://github.com/jesusgraterol/jg-packages/tree/main/packages/jg-personal-react-ui#readme",
  "bugs": {
    "url": "https://github.com/jesusgraterol/jg-packages/issues"
  },
  "scripts": {
    "build": "node ../../internal/build-tools/src/clean-dist.ts && tsc -p tsconfig.build.json && node ../../internal/build-tools/src/copy-assets.ts 'styles/*.css' && node ../../internal/api-reference/src/write-api-markdown.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "pnpm test:e2e",
    "gallery:build": "vite build",
    "gallery:dev": "vite --host 127.0.0.1",
    "test:e2e": "pnpm gallery:build && playwright test"
  },
  "dependencies": {
    "jg-personal-ui": "workspace:^",
    "jg-react-ui": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@jg-packages/eslint-config": "workspace:*",
    "@jg-packages/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "jg-playwright": "workspace:*",
    "jg-process": "workspace:*",
    "vite": "8.3.4"
  }
}
