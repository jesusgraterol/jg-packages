{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/internal/tsconfig/**",
        "$TURBO_ROOT$/internal/build-tools/src/**",
        "$TURBO_ROOT$/internal/api-reference/src/**"
      ],
      "outputs": ["dist/**", "API.md"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/internal/tsconfig/**"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/internal/eslint-config/src/**"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/internal/vitest-config/src/**"],
      "env": ["JG_TEST_SUITE"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/internal/vitest-config/src/**"],
      "env": ["JG_TEST_SUITE"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/internal/vitest-config/src/**"],
      "env": ["JG_TEST_SUITE"],
      "outputs": []
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/internal/vitest-config/src/**"],
      "env": ["JG_TEST_SUITE"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "env": ["JG_TEST_SUITE"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
